# StoreVendor ‑ Marketplace environment variables
# Copy to .env (local) or import into your host. Never commit real values.
# Get the Shopify values with: shopify app env pull

# --- Shopify app ---
# Set by `shopify app dev` locally; set explicitly on hosted environments.
SHOPIFY_APP_URL="https://store-vendor.vercel.app"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,write_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_returns,write_returns,read_customers,read_metaobjects,write_metaobjects,read_metaobject_definitions,write_metaobject_definitions,read_files,write_files,read_shipping,write_shipping,read_payment_customizations,write_payment_customizations,read_delivery_customizations,write_delivery_customizations,read_publications,write_publications,read_markets"

# --- Database (Postgres / Neon) ---
# Pooled URL for the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/storevendor_dev?sslmode=require"
# Direct (unpooled) URL for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/storevendor_dev?sslmode=require"

# --- Later phases (leave empty until needed) ---
# Phase 4: Partner API client created by the organization owner (Manage apps permission)
SHOPIFY_PARTNER_ORG_ID=""
SHOPIFY_PARTNER_API_TOKEN=""
