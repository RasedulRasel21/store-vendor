{%- comment -%}
  "Sold by <seller>" on a product page, linking to that seller's page in this shop.

  Only for products that belong to one of the app's sellers, which is what the vendor_id
  metafield marks. Shopify's own "vendor" field is free text that every product has --
  the shop's own stock included -- and linking those to a seller page sends a shopper
  somewhere that was never there.

  The link itself is built from the vendor's name, which the app writes onto every
  product it links to a seller, and keeps in step when a seller renames themselves. The
  app resolves it either way round, so a name with an apostrophe or an accent still finds
  the right shop.
{%- endcomment -%}

{%- liquid
  assign vendor_id = product.metafields.app.vendor_id.value | default: '' | strip
  assign vendor_name = product.vendor | strip
  assign vendor_handle = vendor_name | handleize
-%}

{%- if vendor_id != blank and vendor_name != blank -%}
  <div class="sv-soldby" {{ block.shopify_attributes }}>
    <span class="sv-soldby__label">{{ block.settings.label | default: 'Sold by' }}</span>
    {%- if block.settings.link_to_page -%}
      <a class="sv-soldby__name" href="/apps/vendors/{{ vendor_handle }}">{{ vendor_name }}</a>
    {%- else -%}
      <span class="sv-soldby__name">{{ vendor_name }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Sold by",
  "target": "section",
  "stylesheet": "vendor-apply.css",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "label", "label": "Wording before the name", "default": "Sold by" },
    {
      "type": "checkbox",
      "id": "link_to_page",
      "label": "Link to the seller's page",
      "default": true,
      "info": "Their page lists who they are, how they ship and their returns."
    }
  ]
}
{% endschema %}
