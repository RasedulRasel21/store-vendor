// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop              String   @id
  // Default commission: a percentage of the line price plus a fixed amount per item.
  commissionPercent Decimal  @default(10) @db.Decimal(5, 2)
  commissionFixed   Decimal  @default(0) @db.Decimal(12, 2)
  setupGuideDismissedAt DateTime?
  // Shop currency (for example "BDT"), saved by the app so the vendor portal can show prices.
  currencyCode      String?
  // The shop's country, which decides the carriers Shopify offers for tracking.
  countryCode       String?
  // When the store's manual collections were last fully synced into ShopCollection.
  collectionsSyncedAt DateTime?
  // The payment customization that runs the cod-rules Function for this shop.
  codRulesCustomizationId String?
  // Days a vendor has to ship an order before it counts as overdue.
  fulfillmentDays   Int      @default(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// The store's manual collections, which vendors can add their products to.
// Smart collections are left out: Shopify adds products to them by their rules.
model ShopCollection {
  id           String   @id @default(cuid())
  shop         String
  // Shopify collection GID.
  collectionId String
  title        String
  handle       String
  imageUrl     String?
  syncedAt     DateTime @default(now())

  @@unique([shop, collectionId])
  @@index([shop, title])
}

enum ProductSubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// A product created by a vendor in the portal. Approval creates the Shopify product.
model ProductSubmission {
  id                String                  @id @default(cuid())
  shop              String
  vendorId          String
  vendor            Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  submittedById     String?
  status            ProductSubmissionStatus @default(DRAFT)
  title             String
  // Plain-text description from the first portal version; new submissions use descriptionHtml.
  description       String?
  descriptionHtml   String?
  productType       String?
  // [{ name, values: [string] }], up to 3 options. Empty means a single default variant.
  options           Json?
  // [{ optionValues: { [optionName]: value }, price, compareAtPrice, sku, barcode, inventoryQuantity }]
  variants          Json?
  trackInventory    Boolean                 @default(true)
  // Shopify collection GIDs chosen by the vendor.
  collectionIds     String[]
  seoTitle          String?
  seoDescription    String?
  handle            String?
  tags              String[]
  price             Decimal?                @db.Decimal(12, 2)
  compareAtPrice    Decimal?                @db.Decimal(12, 2)
  sku               String?
  barcode           String?
  inventoryQuantity Int?
  imageUrls         String[]
  // Shopify product GID, set when the submission is approved.
  productId         String?
  // Edits to a product that's already live wait here until the merchant approves them,
  // so the live product never changes on its own. Same shape as the columns above.
  pendingDraft      Json?
  pendingSubmittedAt DateTime?
  pendingReviewNote String?
  reviewNote        String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([shop, status])
  @@index([vendorId, status])
}

enum ShippingMode {
  VENDOR_SHIPS
  STORE_SHIPS
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VendorOrderStatus {
  OPEN
  // Some items shipped, the rest still to go.
  PARTIAL
  FULFILLED
  // Everything refunded: nothing to ship and nothing to pay out.
  REFUNDED
  CANCELLED
}

// A vendor's share of a Shopify order: their lines, what they earn, and how it ships.
model VendorOrder {
  id       String            @id @default(cuid())
  shop     String
  vendorId String
  vendor   Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status   VendorOrderStatus @default(OPEN)

  // The Shopify order this came from.
  orderId         String
  orderName       String
  currencyCode    String
  // What the buyer actually paid in, when it differs from the shop currency.
  presentmentCurrency String?
  presentmentSubtotal Decimal? @db.Decimal(12, 2)
  // SHIPPING, PICK_UP, LOCAL, NONE or RETAIL, from the order's delivery method.
  deliveryMethod  String?
  // The shipping rate the customer chose at checkout, like "Standard" or "Express",
  // so the vendor knows what service level to buy from their courier.
  shippingMethod  String?
  // Who ships this order, copied from the vendor when the order came in, so changing
  // the vendor's setting later doesn't rewrite past orders.
  shippingMode    ShippingMode @default(VENDOR_SHIPS)
  financialStatus String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  // { address1, address2, city, provinceCode, zip, countryCode, phone }
  shippingAddress Json?

  // Money for this vendor's lines only, in the shop currency.
  subtotal   Decimal @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  shipping   Decimal @default(0) @db.Decimal(12, 2)
  earnings   Decimal @db.Decimal(12, 2)

  // Refunds reverse part of the sale. Payable earnings are earnings minus refundedEarnings.
  refunded           Decimal @default(0) @db.Decimal(12, 2)
  refundedCommission Decimal @default(0) @db.Decimal(12, 2)
  refundedEarnings   Decimal @default(0) @db.Decimal(12, 2)

  placedAt    DateTime
  // When the vendor first opened this order in the portal; drives their "new orders" count.
  vendorSeenAt DateTime?
  paidAt      DateTime?
  fulfilledAt DateTime?
  // When a refund last changed this order, so the timeline can say when it happened.
  refundedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     VendorOrderLine[]
  shipments VendorShipment[]
  returns   VendorReturn[]
  issues    VendorOrderIssue[]

  @@unique([shop, orderId, vendorId])
  @@index([shop, status])
  @@index([vendorId, status])
}

model VendorOrderLine {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  lineItemId   String
  title        String
  variantTitle String?
  sku          String?
  imageUrl     String?
  quantity     Int

  unitPrice  Decimal @db.Decimal(12, 2)
  // Line total after discounts and excluding tax: the base commission is taken from.
  subtotal   Decimal @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  earnings   Decimal @db.Decimal(12, 2)

  // What the buyer paid for this line, in their own currency.
  presentmentSubtotal Decimal? @db.Decimal(12, 2)
  // Digital goods and services don't get posted, so they change the slip's wording.
  requiresShipping    Boolean  @default(true)
  weight              Decimal? @db.Decimal(10, 3)
  weightUnit          String?

  refundedQuantity Int     @default(0)
  refundedSubtotal Decimal @default(0) @db.Decimal(12, 2)
  shippedQuantity  Int     @default(0)

  // Needed to fulfil this line later.
  fulfillmentOrderId         String?
  fulfillmentOrderLineItemId String?
  fulfillableQuantity        Int     @default(0)

  @@index([vendorOrderId])
}

enum CarrierStatus {
  PENDING
  APPROVED
  REJECTED
}

// A courier a vendor asked for because Shopify doesn't list it in this country.
// Once approved, every vendor in the shop can pick it.
model ShopCarrier {
  id                  String       @id @default(cuid())
  shop                String
  name                String
  // Where {tracking_number} is replaced with the number, so links work.
  trackingUrlTemplate String?
  status              CarrierStatus @default(PENDING)
  reason              String?
  reviewNote          String?
  requestedByVendorId String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([shop, name])
  @@index([shop, status])
}

// One parcel: sent by the vendor from the portal, or by the merchant in Shopify admin.
model VendorShipment {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  // Shopify fulfillment GID, used to ignore the webhook for a shipment we just created.
  fulfillmentId   String?
  trackingCompany String?
  trackingNumber  String?
  trackingUrl     String?
  // [{ lineId, title, quantity }]
  items           Json
  // "vendor" or "store"
  shippedBy       String
  createdAt       DateTime    @default(now())

  @@index([vendorOrderId])
  @@index([fulfillmentId])
}

// One row per webhook Shopify delivers. Shopify retries on any slow or failed response, so
// the id is claimed before the work starts and released if the work throws.
model WebhookEvent {
  // The X-Shopify-Webhook-Id header, which is the same across retries of one event.
  id         String   @id
  shop       String
  topic      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// A line the merchant moved to a different vendor by hand. Re-reading an order takes the
// vendor from the product, so the move is kept here to survive every later sync.
model OrderLineVendor {
  id         String @id @default(cuid())
  shop       String
  // The Shopify order and line item GIDs, which outlive our own rows.
  orderId    String
  lineItemId String

  vendorId     String
  vendor       Vendor  @relation("MovedToVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  fromVendorId String?

  title     String
  movedBy   String
  createdAt DateTime @default(now())

  @@unique([shop, orderId, lineItemId])
  @@index([shop, orderId])
  @@index([vendorId])
}

// A vendor saying they can't ship an order, or part of it. Cancelling and refunding stay in
// Shopify, where the money is; this is how the vendor tells the merchant it needs doing.
model VendorOrderIssue {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  // OUT_OF_STOCK, DAMAGED, ADDRESS, DELAY or OTHER.
  reason String
  note   String?
  status OrderIssueStatus @default(OPEN)
  // What the merchant said when they closed it.
  reviewNote String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([vendorOrderId])
  @@index([status])
}

enum OrderIssueStatus {
  OPEN
  RESOLVED
  WITHDRAWN
}

// A return the customer asked for, kept per vendor order so a vendor only sees their own
// items coming back. The money side stays with refunds; this is the request and its state.
model VendorReturn {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  // Shopify Return GID, and the name the customer sees, like "#1001-R1".
  returnId String
  name     String?
  // REQUESTED, OPEN, DECLINED, CANCELED or CLOSED, straight from Shopify.
  status   String
  // [{ lineId, title, quantity, reason, note }]
  items    Json

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendorOrderId, returnId])
  @@index([vendorOrderId])
}

enum PayoutMethod {
  BANK
  BKASH
  NAGAD
  ROCKET
}

enum ChangeRequestType {
  PAYOUT
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Replaced by a newer request, or withdrawn by the vendor.
  CANCELLED
}

enum VendorUserRole {
  OWNER
  STAFF
}

enum VendorUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Vendor {
  id           String       @id @default(cuid())
  shop         String
  name         String
  handle       String
  email        String
  phone        String?
  status       VendorStatus @default(PENDING)
  statusReason String?
  notes        String?
  approvedAt   DateTime?

  // Null means the vendor uses the store's default commission.
  commissionPercent Decimal? @db.Decimal(5, 2)
  commissionFixed   Decimal? @db.Decimal(12, 2)

  shippingMode     ShippingMode @default(VENDOR_SHIPS)
  // Whether cash on delivery is offered for carts with this vendor's products.
  codEnabled       Boolean      @default(true)
  // Null means no maximum order value for cash on delivery.
  codMaxOrderValue Decimal?     @db.Decimal(12, 2)

  // Pickup and return address. Vendors edit it in the portal.
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  countryCode  String?

  // Approved payout details. Vendors can't change them directly: they send a change
  // request that the merchant approves. Details: { accountName, accountNumber,
  // bankName?, branchName?, routingNumber? }.
  payoutMethod    PayoutMethod?
  payoutDetails   Json?
  payoutUpdatedAt DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users              VendorUser[]
  products           VendorProduct[]
  activities         VendorActivity[]
  productSubmissions ProductSubmission[]
  changeRequests     VendorChangeRequest[]
  orders             VendorOrder[]
  movedOrderLines    OrderLineVendor[]     @relation("MovedToVendor")

  @@unique([shop, handle])
  @@unique([shop, email])
  @@index([shop, status])
}

// A vendor's request to change a sensitive setting, applied only when the merchant approves.
model VendorChangeRequest {
  id            String              @id @default(cuid())
  shop          String
  vendorId      String
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type          ChangeRequestType
  status        ChangeRequestStatus @default(PENDING)
  // The requested values. PAYOUT: { method, details }.
  requested     Json
  // The approved values when the request was made, so reviews show what changed.
  previous      Json?
  requestedById String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([shop, status])
  @@index([vendorId, type, status])
}

// Portal login accounts for a vendor. Credentials are owned by the vendor portal.
model VendorUser {
  id              String           @id @default(cuid())
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  role            VendorUserRole   @default(OWNER)
  status          VendorUserStatus @default(INVITED)
  inviteTokenHash String?          @unique
  inviteExpiresAt DateTime?
  // Set by the vendor portal when the invite is accepted.
  passwordHash    String?
  // Portal sign-in lockout: reset on success, locked for a while after repeated failures.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions VendorSession[]

  @@unique([vendorId, email])
}

// Signed-in vendor portal sessions. Only the SHA-256 hash of the cookie token is stored.
model VendorSession {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  vendorUserId String
  vendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([vendorUserId])
}

// Maps a Shopify product (GID) to the vendor that owns it.
model VendorProduct {
  id        String   @id @default(cuid())
  shop      String
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([shop, productId])
  @@index([vendorId])
}

model VendorActivity {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  action    String
  actor     String
  details   Json?
  createdAt DateTime @default(now())

  @@index([vendorId, createdAt])
}
