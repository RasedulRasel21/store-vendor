// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop              String   @id
  // Default commission: a percentage of the line price plus a fixed amount per item.
  commissionPercent Decimal  @default(10) @db.Decimal(5, 2)
  commissionFixed   Decimal  @default(0) @db.Decimal(12, 2)
  setupGuideDismissedAt DateTime?
  // Shop currency (for example "BDT"), saved by the app so the vendor portal can show prices.
  currencyCode      String?
  // The shop's country, which decides the carriers Shopify offers for tracking.
  countryCode       String?
  // When the store's manual collections were last fully synced into ShopCollection.
  collectionsSyncedAt DateTime?
  // The payment customization that runs the cod-rules Function for this shop.
  codRulesCustomizationId String?
  // Days a vendor has to ship an order before it counts as overdue.
  fulfillmentDays   Int      @default(3)
  // Where returned stock goes back on the shelf. Until the merchant picks one, vendors
  // can't restock, because guessing a location would move stock to the wrong shop floor.
  restockLocationId   String?
  restockLocationName String?
  // Shipping labels, bought through the merchant's own carrier account. The key is stored
  // encrypted and never leaves the server; labelAccount is just what to show in Settings.
  labelProvider  String?
  labelApiKey    String?
  labelAccount   String?
  // How long after an order is both paid and shipped before the vendor's share can be paid
  // out, counted in DAYS, WEEKS or MONTHS. Covers the store's own payout delay from Shopify
  // and the returns window.
  payoutHoldValue Int    @default(7)
  payoutHoldUnit  String @default("DAYS")
  // An optional floor: with it off, any balance can be paid out.
  payoutMinimumEnabled Boolean @default(false)
  payoutMinimum        Decimal @default(0) @db.Decimal(12, 2)
  // Whether vendors can ask for their available balance instead of waiting.
  payoutRequests Boolean @default(true)
  // MANUAL, WEEKLY (Mondays) or MONTHLY (the 1st): when everyone due is set aside to pay.
  payoutSchedule String  @default("MANUAL")
  // Off: a refund hands back the store's commission on the refunded items too. On: the
  // store keeps its commission and the vendor carries the whole refund.
  refundKeepsCommission Boolean @default(false)
  // The store as vendors see it on emails: its name as the sender, and its contact address
  // for replies. Both come from Shopify, so there's nothing for the merchant to set up.
  shopName  String?
  shopEmail String?
  // The storefront's own address, where the app's proxied pages are served from.
  shopDomain String?
  // The store as the seller on commission invoices. Invoices show a clear placeholder for
  // anything not filled in, so they work before the real details are ready.
  businessName      String?
  businessAddress   String?
  businessTaxId     String?
  // What the tax is called where the store is: VAT, GST, Sales tax.
  taxLabel          String  @default("VAT")
  // Tax charged on the commission, as a percentage. Zero where commission isn't taxed.
  commissionTaxRate Decimal @default(0) @db.Decimal(5, 2)
  invoicePrefix     String  @default("SV-")
  // Issue last month's invoices on the 1st without anyone clicking.
  autoInvoices      Boolean @default(false)
  // Marketplace tax reporting thresholds. They change with the law, so they're settings:
  // US 1099-K (federal: $20,000 and 200 transactions) and the EU DAC7 exemption for goods
  // sellers (fewer than 30 sales and under €2,000 a year).
  us1099kAmount       Decimal @default(20000) @db.Decimal(12, 2)
  us1099kTransactions Int     @default(200)
  dac7MinTransactions Int     @default(30)
  dac7MinAmount       Decimal @default(2000) @db.Decimal(12, 2)
  // Paying vendors in their own currency. Rates are per one unit of the shop currency,
  // like { "USD": "0.0082" }: the bank sets the real rate, so these only say how much to
  // send and are copied onto each payout. Fetched daily unless the merchant turns that off
  // and types their own. The base is remembered so rates can't outlive a currency change.
  // The store's public "sell with us" page: its address, whether it's taking applications,
  // and what it says. The handle is unique across every store, because the page is served
  // from one address for all of them.
  applyHandle   String?  @unique
  applyOpen     Boolean  @default(true)
  applyIntro    String?
  applyTermsUrl String?

  // A pause on payouts for a while after a vendor's payout details change, so a change
  // nobody meant to make can be caught before money follows it.
  payoutChangeHoldEnabled Boolean @default(true)
  payoutChangeHoldHours   Int     @default(48)
  payoutFxEnabled Boolean   @default(false)
  payoutFxAuto    Boolean   @default(true)
  payoutFxRates   Json?
  payoutFxRatesAt DateTime?
  payoutFxBase    String?
  payoutFxSource  String?
  // Automatic payout rails, sending from the merchant's own accounts. Credentials are
  // encrypted; the *Account fields are only labels for Settings.
  paypalMode        String?
  paypalCredentials String?
  paypalAccount     String?
  stripeSecretKey   String?
  stripeAccount     String?
  // Send through a connected rail as soon as a payout is set aside, instead of waiting for
  // the merchant to press Send.
  autoSendPayouts   Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// The store's manual collections, which vendors can add their products to.
// Smart collections are left out: Shopify adds products to them by their rules.
model ShopCollection {
  id           String   @id @default(cuid())
  shop         String
  // Shopify collection GID.
  collectionId String
  title        String
  handle       String
  imageUrl     String?
  syncedAt     DateTime @default(now())

  @@unique([shop, collectionId])
  @@index([shop, title])
}

enum ProductSubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// A product created by a vendor in the portal. Approval creates the Shopify product.
model ProductSubmission {
  id                String                  @id @default(cuid())
  shop              String
  vendorId          String
  vendor            Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  submittedById     String?
  status            ProductSubmissionStatus @default(DRAFT)
  title             String
  // Plain-text description from the first portal version; new submissions use descriptionHtml.
  description       String?
  descriptionHtml   String?
  productType       String?
  // [{ name, values: [string] }], up to 3 options. Empty means a single default variant.
  options           Json?
  // [{ optionValues: { [optionName]: value }, price, compareAtPrice, sku, barcode, inventoryQuantity }]
  variants          Json?
  trackInventory    Boolean                 @default(true)
  // Shopify collection GIDs chosen by the vendor.
  collectionIds     String[]
  seoTitle          String?
  seoDescription    String?
  handle            String?
  tags              String[]
  price             Decimal?                @db.Decimal(12, 2)
  compareAtPrice    Decimal?                @db.Decimal(12, 2)
  sku               String?
  barcode           String?
  inventoryQuantity Int?
  imageUrls         String[]
  // Shopify product GID, set when the submission is approved.
  productId         String?
  // Edits to a product that's already live wait here until the merchant approves them,
  // so the live product never changes on its own. Same shape as the columns above.
  pendingDraft      Json?
  pendingSubmittedAt DateTime?
  pendingReviewNote String?
  reviewNote        String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([shop, status])
  @@index([vendorId, status])
}

enum ShippingMode {
  VENDOR_SHIPS
  STORE_SHIPS
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VendorOrderStatus {
  OPEN
  // Some items shipped, the rest still to go.
  PARTIAL
  FULFILLED
  // Everything refunded: nothing to ship and nothing to pay out.
  REFUNDED
  CANCELLED
}

// A vendor's share of a Shopify order: their lines, what they earn, and how it ships.
model VendorOrder {
  id       String            @id @default(cuid())
  shop     String
  vendorId String
  vendor   Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status   VendorOrderStatus @default(OPEN)

  // The Shopify order this came from.
  orderId         String
  orderName       String
  currencyCode    String
  // What the buyer actually paid in, when it differs from the shop currency.
  presentmentCurrency String?
  presentmentSubtotal Decimal? @db.Decimal(12, 2)
  // SHIPPING, PICK_UP, LOCAL, NONE or RETAIL, from the order's delivery method.
  deliveryMethod  String?
  // The shipping rate the customer chose at checkout, like "Standard" or "Express",
  // so the vendor knows what service level to buy from their courier.
  shippingMethod  String?
  // Who ships this order, copied from the vendor when the order came in, so changing
  // the vendor's setting later doesn't rewrite past orders.
  shippingMode    ShippingMode @default(VENDOR_SHIPS)
  financialStatus String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  // { address1, address2, city, provinceCode, zip, countryCode, phone }
  shippingAddress Json?

  // Money for this vendor's lines only, in the shop currency.
  subtotal   Decimal @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  shipping   Decimal @default(0) @db.Decimal(12, 2)
  earnings   Decimal @db.Decimal(12, 2)

  // The store's refund rule when this order came in, so changing the setting later
  // doesn't rewrite refunds on orders sold under the old rule.
  refundKeepsCommission Boolean @default(false)

  // Refunds reverse part of the sale. Payable earnings are earnings minus refundedEarnings.
  refunded           Decimal @default(0) @db.Decimal(12, 2)
  refundedCommission Decimal @default(0) @db.Decimal(12, 2)
  refundedEarnings   Decimal @default(0) @db.Decimal(12, 2)

  placedAt    DateTime
  // When the vendor first opened this order in the portal; drives their "new orders" count.
  vendorSeenAt DateTime?
  // When the vendor said they're on it. Opening an order isn't the same as taking it on,
  // so this is what tells the merchant someone is actually packing it.
  acceptedAt  DateTime?
  paidAt      DateTime?
  fulfilledAt DateTime?
  // When a refund last changed this order, so the timeline can say when it happened.
  refundedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     VendorOrderLine[]
  shipments VendorShipment[]
  returns   VendorReturn[]
  issues    VendorOrderIssue[]
  ledgerEntries LedgerEntry[]

  @@unique([shop, orderId, vendorId])
  @@index([shop, status])
  @@index([vendorId, status])
}

model VendorOrderLine {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  lineItemId   String
  title        String
  variantTitle String?
  sku          String?
  imageUrl     String?
  quantity     Int

  unitPrice  Decimal @db.Decimal(12, 2)
  // Line total after discounts and excluding tax: the base commission is taken from.
  subtotal   Decimal @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  earnings   Decimal @db.Decimal(12, 2)

  // What the buyer paid for this line, in their own currency.
  presentmentSubtotal Decimal? @db.Decimal(12, 2)
  // Digital goods and services don't get posted, so they change the slip's wording.
  requiresShipping    Boolean  @default(true)
  weight              Decimal? @db.Decimal(10, 3)
  weightUnit          String?

  refundedQuantity Int     @default(0)
  refundedSubtotal Decimal @default(0) @db.Decimal(12, 2)
  shippedQuantity  Int     @default(0)

  // Needed to fulfil this line later.
  fulfillmentOrderId         String?
  fulfillmentOrderLineItemId String?
  fulfillableQuantity        Int     @default(0)

  @@index([vendorOrderId])
}

enum CarrierStatus {
  PENDING
  APPROVED
  REJECTED
}

// A courier a vendor asked for because Shopify doesn't list it in this country.
// Once approved, every vendor in the shop can pick it.
model ShopCarrier {
  id                  String       @id @default(cuid())
  shop                String
  name                String
  // Where {tracking_number} is replaced with the number, so links work.
  trackingUrlTemplate String?
  status              CarrierStatus @default(PENDING)
  reason              String?
  reviewNote          String?
  requestedByVendorId String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([shop, name])
  @@index([shop, status])
}

// One parcel: sent by the vendor from the portal, or by the merchant in Shopify admin.
model VendorShipment {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  // Shopify fulfillment GID, used to ignore the webhook for a shipment we just created.
  fulfillmentId   String?
  trackingCompany String?
  trackingNumber  String?
  trackingUrl     String?
  // [{ lineId, title, quantity }]
  items           Json
  // "vendor" or "store"
  shippedBy       String
  createdAt       DateTime    @default(now())

  @@index([vendorOrderId])
  @@index([fulfillmentId])
}

// What the store owes each vendor, one row per movement and never edited. Balances are
// sums of rows, so every figure a vendor sees can be traced back to what caused it.
model LedgerEntry {
  id       String          @id @default(cuid())
  shop     String
  vendorId String
  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type     LedgerEntryType
  // Signed, in the shop currency: positive is owed to the vendor, negative takes it back.
  amount       Decimal @db.Decimal(12, 2)
  currencyCode String

  vendorOrderId String?
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)
  // Kept on the row so a statement still reads properly if the vendor order goes.
  orderName     String?
  payoutId      String?
  payout        Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  description String
  // "system", "merchant" or "vendor_user:<id>".
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([shop, vendorId, createdAt])
  @@index([vendorOrderId])
  @@index([payoutId])
}

enum LedgerEntryType {
  // The vendor's share of an order.
  SALE
  // A refund took some of it back.
  REFUND
  // The order was cancelled, so none of it is owed.
  CANCELLATION
  // The order was edited, an item moved vendor, or the merchant credited or debited by hand.
  ADJUSTMENT
  // Money sent to the vendor.
  PAYOUT
  // A payout was cancelled or failed, so the money is owed again.
  PAYOUT_REVERSAL
}

// Money sent, or about to be sent, to one vendor. The app never moves it: the merchant
// pays from their own account and this records that they did.
model Payout {
  id           String       @id @default(cuid())
  shop         String
  vendorId     String
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount       Decimal      @db.Decimal(12, 2)
  currencyCode String
  status       PayoutStatus @default(PENDING)

  // How it goes, copied from the vendor when the payout is made so a later change to
  // their details can't rewrite where past money went.
  method  PayoutMethod?
  details Json?
  // The bank or wallet transaction reference, entered once the money is sent.
  reference String?

  // When the vendor is paid in another currency: what to send, and the rate used. The
  // amount above stays in the shop currency, because that's what the vendor is owed.
  payoutCurrency String?
  payoutAmount   Decimal? @db.Decimal(14, 2)
  fxRate         Decimal? @db.Decimal(18, 8)

  // Set when the payout went through PayPal or Stripe rather than by hand: which one, its
  // id there, and the last status it reported.
  provider       String?
  providerRef    String?
  providerStatus String?
  sentAt         DateTime?
  note      String?

  // Set when the vendor asked for it rather than the merchant starting it.
  requestedAt DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  entries LedgerEntry[]

  @@index([shop, status])
  @@index([vendorId, createdAt])
}

enum PayoutStatus {
  // A vendor asked; nothing is set aside until the merchant accepts.
  REQUESTED
  // Set aside from the balance, waiting for the merchant to send it.
  PENDING
  PAID
  // The transfer bounced; the money is owed again.
  FAILED
  // Called off before it went, or a request turned down.
  CANCELLED
}

// The store's invoice to a vendor for its commission over a month. Issued once and never
// edited: everything printed is copied onto the row, and a refund after issue shows up as
// a credit line on the next invoice rather than changing this one.
model CommissionInvoice {
  id       String @id @default(cuid())
  shop     String
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Sequential per store, like SV-2026-0001, as tax rules expect.
  number   String
  sequence Int

  periodStart DateTime
  periodEnd   DateTime

  currencyCode String
  net          Decimal @db.Decimal(12, 2)
  taxLabel     String
  taxRate      Decimal @db.Decimal(5, 2)
  taxAmount    Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  // [{ vendorOrderId, orderName, date, description, amount }]
  lines  Json
  // { name, address, taxId } for the store and the vendor as they were on the day.
  seller Json
  buyer  Json

  issuedAt DateTime @default(now())

  @@unique([shop, number])
  @@unique([shop, vendorId, periodStart])
  @@index([vendorId, issuedAt])
}

// Every email the app sends or would send. Written before the provider is called, so a
// message that fails, or has no provider to go through, is still on record.
model EmailMessage {
  id       String      @id @default(cuid())
  shop     String
  to       String
  subject  String
  text     String
  html     String?
  // What kind of message, like "payout.paid", for filtering the log.
  template String
  status   EmailStatus @default(QUEUED)
  error    String?
  // The provider's id for the message, to look it up on their side.
  providerId String?
  // What it's about, so the log can link back to it.
  relatedType String?
  relatedId   String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([shop, createdAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  // No provider set up, so it was only logged.
  SKIPPED
}

// One row per webhook Shopify delivers. Shopify retries on any slow or failed response, so
// the id is claimed before the work starts and released if the work throws.
model WebhookEvent {
  // The X-Shopify-Webhook-Id header, which is the same across retries of one event.
  id         String   @id
  shop       String
  topic      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// A line the merchant moved to a different vendor by hand. Re-reading an order takes the
// vendor from the product, so the move is kept here to survive every later sync.
model OrderLineVendor {
  id         String @id @default(cuid())
  shop       String
  // The Shopify order and line item GIDs, which outlive our own rows.
  orderId    String
  lineItemId String

  vendorId     String
  vendor       Vendor  @relation("MovedToVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  fromVendorId String?

  title     String
  movedBy   String
  createdAt DateTime @default(now())

  @@unique([shop, orderId, lineItemId])
  @@index([shop, orderId])
  @@index([vendorId])
}

// A vendor saying they can't ship an order, or part of it. Cancelling and refunding stay in
// Shopify, where the money is; this is how the vendor tells the merchant it needs doing.
model VendorOrderIssue {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  // OUT_OF_STOCK, DAMAGED, ADDRESS, DELAY or OTHER.
  reason String
  note   String?
  status OrderIssueStatus @default(OPEN)
  // What the merchant said when they closed it.
  reviewNote String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([vendorOrderId])
  @@index([status])
}

enum OrderIssueStatus {
  OPEN
  RESOLVED
  WITHDRAWN
}

// A return the customer asked for, kept per vendor order so a vendor only sees their own
// items coming back. The money side stays with refunds; this is the request and its state.
model VendorReturn {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  // Shopify Return GID, and the name the customer sees, like "#1001-R1".
  returnId String
  name     String?
  // REQUESTED, OPEN, DECLINED, CANCELED or CLOSED, straight from Shopify.
  status   String
  // [{ lineId, title, quantity, reason, note }]
  items    Json

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendorOrderId, returnId])
  @@index([vendorOrderId])
}

// Where a vendor wants their money. Bank works everywhere; the wallets are local rails
// (bKash, Nagad and Rocket in Bangladesh, UPI in India, M-Pesa in East Africa); PayPal,
// Payoneer and Wise reach vendors abroad. OTHER covers anything else the merchant agrees to.
enum PayoutMethod {
  BANK
  BKASH
  NAGAD
  ROCKET
  UPI
  MPESA
  PAYPAL
  PAYONEER
  WISE
  // A Stripe account connected to the merchant's Stripe platform.
  STRIPE
  OTHER
}

enum ChangeRequestType {
  PAYOUT
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Replaced by a newer request, or withdrawn by the vendor.
  CANCELLED
}

enum VendorUserRole {
  OWNER
  STAFF
}

enum VendorUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Vendor {
  id           String       @id @default(cuid())
  shop         String
  name         String
  handle       String
  email        String
  phone        String?
  status       VendorStatus @default(PENDING)
  statusReason String?
  notes        String?
  approvedAt   DateTime?

  // What they said when they applied to sell, for a vendor who came in through the store's
  // own application form rather than being added by the merchant:
  // { contactName, website?, sells, catalogueSize?, message?, agreedTerms }.
  // Kept after approval, so the merchant can look back at what was promised.
  application   Json?
  appliedAt     DateTime?
  // A one-way fingerprint of the address it was sent from, so a flood of applications can
  // be spotted and slowed without keeping anyone's IP address.
  applicantHash String?

  // Null means the vendor uses the store's default commission.
  commissionPercent Decimal? @db.Decimal(5, 2)
  commissionFixed   Decimal? @db.Decimal(12, 2)

  shippingMode     ShippingMode @default(VENDOR_SHIPS)
  // Whether cash on delivery is offered for carts with this vendor's products.
  codEnabled       Boolean      @default(true)
  // Null means no maximum order value for cash on delivery.
  codMaxOrderValue Decimal?     @db.Decimal(12, 2)

  // Pickup and return address. Vendors edit it in the portal.
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  countryCode  String?

  // Approved payout details. Vendors can't change them directly: they send a change
  // request that the merchant approves. Details: { accountName, accountNumber,
  // bankName?, branchName?, routingNumber? }.
  payoutMethod    PayoutMethod?
  payoutDetails   Json?
  payoutUpdatedAt DateTime?

  // Tax details for invoices and marketplace tax reporting (1099-K, DAC7):
  // { entityType: INDIVIDUAL | BUSINESS, legalName, countryCode, taxIdType, taxIdLast4,
  //   dateOfBirth?, address: { line1, line2?, city, postalCode, countryCode } }.
  // The full tax ID is kept apart and encrypted, so it's never read by accident.
  taxInfo          Json?
  taxIdEncrypted   String?
  taxInfoUpdatedAt DateTime?

  // The vendor's Stripe account on the merchant's Stripe platform, once they've started
  // Stripe's onboarding. Only used for payouts after the merchant approves switching to it.
  stripeAccountId String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users              VendorUser[]
  products           VendorProduct[]
  activities         VendorActivity[]
  productSubmissions ProductSubmission[]
  changeRequests     VendorChangeRequest[]
  orders             VendorOrder[]
  movedOrderLines    OrderLineVendor[]     @relation("MovedToVendor")
  ledgerEntries      LedgerEntry[]
  payouts            Payout[]
  invoices           CommissionInvoice[]

  @@unique([shop, handle])
  @@unique([shop, email])
  @@index([shop, status])
}

// A vendor's request to change a sensitive setting, applied only when the merchant approves.
model VendorChangeRequest {
  id            String              @id @default(cuid())
  shop          String
  vendorId      String
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type          ChangeRequestType
  status        ChangeRequestStatus @default(PENDING)
  // The requested values. PAYOUT: { method, details }.
  requested     Json
  // The approved values when the request was made, so reviews show what changed.
  previous      Json?
  requestedById String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([shop, status])
  @@index([vendorId, type, status])
}

// Portal login accounts for a vendor. Credentials are owned by the vendor portal.
model VendorUser {
  id              String           @id @default(cuid())
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  role            VendorUserRole   @default(OWNER)
  status          VendorUserStatus @default(INVITED)
  inviteTokenHash String?          @unique
  inviteExpiresAt DateTime?
  // Set by the vendor portal when the invite is accepted.
  passwordHash    String?
  // Portal sign-in lockout: reset on success, locked for a while after repeated failures.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions VendorSession[]

  @@unique([vendorId, email])
}

// Signed-in vendor portal sessions. Only the SHA-256 hash of the cookie token is stored.
model VendorSession {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  vendorUserId String
  vendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([vendorUserId])
}

// Maps a Shopify product (GID) to the vendor that owns it.
model VendorProduct {
  id        String   @id @default(cuid())
  shop      String
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([shop, productId])
  @@index([vendorId])
}

model VendorActivity {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  action    String
  actor     String
  details   Json?
  createdAt DateTime @default(now())

  @@index([vendorId, createdAt])
}
